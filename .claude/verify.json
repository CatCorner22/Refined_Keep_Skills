{
  "fast_checks": [
    {
      "name": "build-check",
      "command": "python3 -B tools/build.py check",
      "timeout_seconds": 120
    },
    {
      "name": "agent-discipline-tests",
      "command": "python3 -B -m unittest discover -s tests",
      "timeout_seconds": 600
    },
    {
      "name": "verified-build-loop-hook-tests",
      "command": "python3 -B -m unittest discover -s verified-build-loop/plugin/skills/verified-build-loop/tests",
      "timeout_seconds": 300
    },
    {
      "name": "verified-build-loop-package-tests",
      "command": "python3 -B -m unittest discover -s verified-build-loop/tests",
      "timeout_seconds": 60
    },
    {
      "name": "chicken-little-overwatch-tests",
      "command": "python3 -B -m unittest discover -s chicken-little-overwatch/tests",
      "timeout_seconds": 300
    },
    {
      "name": "claude-code-plugins-tests",
      "command": "python3 -B -m unittest discover -s plugins/tests",
      "timeout_seconds": 300
    }
  ],
  "full_checks": [],
  "lint_on_edit": {
    "command": "python3 -B -c \"import ast,sys; ast.parse(open(sys.argv[1], encoding='utf-8').read(), sys.argv[1])\" {file}",
    "extensions": [
      ".py"
    ],
    "timeout_seconds": 60
  },
  "protected": [],
  "feature_list": "feature_list.json",
  "fingerprint_exclude": [],
  "plan_gate": true
}
